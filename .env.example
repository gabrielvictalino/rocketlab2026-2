# Docker Compose (copy to .env in the repository root)
WEB_PORT=8080
API_PORT=8000
ADMIN_USERNAME=admin
# Generate with: docker compose run --rm --no-deps backend python -m app.scripts.admin
# Keep the single quotes around the generated hash to preserve its dollar signs.
ADMIN_PASSWORD_HASH=''
AUTH_SECRET=''
AUTH_TOKEN_TTL_SECONDS=3600
